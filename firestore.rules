rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function memberDoc(siteId) {
      return /databases/$(database)/documents/sites/$(siteId)/members/$(request.auth.uid);
    }

    function isMember(siteId) {
      return signedIn() && exists(memberDoc(siteId)) && get(memberDoc(siteId)).data.active == true
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.active == true;
    }

    function memberData(siteId) {
      return get(memberDoc(siteId)).data;
    }

    function hasPermission(siteId, permission) {
      return isMember(siteId) && permission in memberData(siteId).permissions;
    }

    // Profil hanya boleh dibaca pemiliknya; perubahan peran lewat Functions.
    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    match /sites/{siteId} {
      allow read: if isMember(siteId);
      allow write: if false;

      match /members/{uid} {
        allow read: if isMember(siteId) && request.auth.uid == uid;
        allow write: if false;
      }

      match /tempeks/{tempekId} {
        allow read: if isMember(siteId);
        allow write: if false;
      }
      match /channels/{channelId} {
        allow read: if isMember(siteId);
        allow write: if false;
      }
    }

    // Metadata perangkat dapat dibaca anggota situs; provisioning via admin.
    match /devices/{deviceId} {
      allow read: if signedIn() && isMember(resource.data.siteId);
      allow write: if false;
    }

    match /gateways/{gatewayId} {
      allow read: if signedIn() && isMember(resource.data.siteId);
      allow write: if false;
    }

    match /telemetryLatest/{deviceId} {
      allow read: if signedIn() && isMember(
        get(/databases/$(database)/documents/devices/$(deviceId)).data.siteId
      );
      allow write: if false;
    }

    match /telemetryEvents/{eventId} {
      allow read: if signedIn() && isMember(resource.data.siteId);
      allow write: if false;
    }

    // Aturan air: dibaca anggota; semua perubahan lewat Functions.
    match /waterRules/{ruleId} {
      allow read: if signedIn() && isMember(resource.data.siteId);
      allow write: if false;

      match /versions/{versionId} {
        allow read: if signedIn() && isMember(
          get(/databases/$(database)/documents/waterRules/$(ruleId)).data.siteId
        );
        allow write: if false;
      }
    }

    match /waterSchedules/{scheduleId} {
      allow read: if signedIn() && isMember(resource.data.siteId);
      allow write: if false;
    }

    match /commands/{commandId} {
      allow read: if signedIn() && isMember(resource.data.siteId);
      allow write: if false;
    }

    match /gateEvents/{eventId} {
      allow read: if signedIn() && isMember(resource.data.siteId);
      allow write: if false;
    }

    match /waterLedger/{entryId} {
      allow read: if signedIn() && isMember(resource.data.siteId);
      allow write: if false;
    }

    match /ledgerSeals/{sealId} {
      allow read: if signedIn() && isMember(resource.data.siteId);
      allow write: if false;
    }

    match /alerts/{alertId} {
      allow read: if signedIn() && isMember(resource.data.siteId);
      allow write: if false;
    }

    match /auditEvents/{eventId} {
      allow read: if signedIn() && hasPermission(resource.data.siteId, 'audit.view');
      allow write: if false;
    }

    // Chat pribadi: hanya pemilik sesi.
    match /chatSessions/{sessionId} {
      function ownsSession() {
        return signedIn() && resource.data.ownerUid == request.auth.uid && isMember(resource.data.siteId);
      }
      allow read, delete: if ownsSession();
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid
        && isMember(request.resource.data.siteId)
        && request.resource.data.keys().hasOnly(['ownerUid', 'siteId', 'createdAt', 'updatedAt'])
        && request.resource.data.createdAt == request.time && request.resource.data.updatedAt == request.time;
      allow update: if ownsSession()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['updatedAt'])
        && request.resource.data.updatedAt == request.time;

      match /messages/{messageId} {
        function ownsParent() {
          let parent = get(/databases/$(database)/documents/chatSessions/$(sessionId)).data;
          return signedIn() && parent.ownerUid == request.auth.uid && isMember(parent.siteId);
        }
        allow read, delete: if ownsParent();
        allow create: if ownsParent()
          && request.resource.data.keys().hasOnly(['ownerUid', 'role', 'text', 'createdAt'])
          && request.resource.data.ownerUid == request.auth.uid && request.resource.data.role == 'user'
          && request.resource.data.text is string && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000 && request.resource.data.createdAt == request.time;
        allow update: if false;
      }
    }

    match /fcmTokens/{tokenId} {
      allow read, delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
      allow create, update: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && (resource == null || resource.data.ownerUid == request.auth.uid)
        && request.resource.data.keys().hasOnly(['ownerUid', 'token', 'platform', 'updatedAt'])
        && request.resource.data.token is string && request.resource.data.token.size() <= 4096
        && request.resource.data.platform == 'android' && request.resource.data.updatedAt == request.time;
    }

    // Nilai default: tolak.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
