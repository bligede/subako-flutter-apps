{
  "name": "subako-development-tools",
  "version": "0.2.1",
  "private": true,
  "engines": { "node": ">=24.12.0" },
  "scripts": {
    "test:rules": "firebase emulators:exec --project demo-subako --only firestore \"node --test test/firebase/rules.test.mjs\"",
    "test:backend": "npm --prefix functions run build && firebase emulators:exec --project demo-subako --only auth,firestore,functions \"node --test test/firebase/workflows.test.cjs\"",
    "emulators": "firebase emulators:start --project demo-subako --only auth,firestore,functions"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "6.0.0",
    "firebase": "13.2.0",
    "firebase-tools": "15.34.0"
  }
}
